            yellow "可粘贴完整命令，将自动去除前缀仅保留 eyJ 令牌"
            reading "请输入隧道令牌/JSON (回车取消): " argo_auth
            argo_auth=$(clean_argo_token "$argo_auth")
            [ -z "$argo_auth" ] && { yellow "已取消"; return; }
            ARGO_DOMAIN="$argo_domain"
            ARGO_TOKEN="$argo_auth"
            ARGO_USE_FIXED=1
            ArgoDomain="$argo_domain"
