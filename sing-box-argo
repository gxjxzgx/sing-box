            save_argo_fixed_conf
            rewrite_argo_service
            restart_argo
            sleep 1
            change_argo_domain
            ;;
        5)
            clear
            clear_argo_fixed_conf
            rewrite_argo_service
            restart_argo
            get_quick_tunnel
            change_argo_domain
            ;;
        6)
            if [ -f "${work_dir}/argo-start.sh" ] && grep -q -- '--url http://localhost' "${work_dir}/argo-start.sh" 2>/dev/null; then
                get_quick_tunnel && change_argo_domain
